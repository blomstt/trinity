<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <!-- No ICU locale data: games format their own text -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Everything must run under NativeAOT: the trim and AOT analyzers flag reflection at build time -->
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.1.0</Version>
    <Authors>blomst</Authors>
    <Product>Trinity</Product>
    <!-- BRUTAL package versions, one place to bump them -->
    <BrutalVersion>2026.10.1</BrutalVersion>
    <BrutalVersion2>2026.10.2</BrutalVersion2>
  </PropertyGroup>
  <!-- PublishAot switches off what hot reload needs in every build; turn it back on outside Release, so the
       editor's Play (a Debug build under dotnet watch) can apply saved scripts. Release and published builds keep it off. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <StartupHookSupport>true</StartupHookSupport>
    <MetadataUpdaterSupport>true</MetadataUpdaterSupport>
    <!-- Debug.Line and friends; calls compile away in Release (shipping) builds -->
    <DefineConstants>$(DefineConstants);TRINITY_DEBUG_DRAW</DefineConstants>
  </PropertyGroup>
</Project>
